# Copy this file to ".env" for local development. NEVER commit ".env" to Git.
# Add the SAME two values in Vercel -> Project -> Settings -> Environment Variables.
# Do NOT prefix secrets with VITE_ (that would expose them in the browser bundle).

# Atlas -> Connect -> Drivers -> copy the connection string, then put your DB user's password in.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=govtjob

# ---------------------------------------------------------------------------
# OPTIONAL (Phase 7). Leave unset to keep these features switched off.
# ---------------------------------------------------------------------------

# Scheduled job import (Vercel Cron). Any random string of 16+ characters. Unset = cron disabled.
# CRON_SECRET=

# File uploads via Cloudinary (free tier available). All three are required to enable uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# AI script drafts via the Anthropic API. PAID per use. Unset = AI button hidden.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_DAILY_LIMIT=20
